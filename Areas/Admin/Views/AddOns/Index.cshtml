@model IEnumerable<EventMVC.Models.AddOn>

@{
    ViewData["Title"] = "Add-ons";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .search-bar {
        background: var(--white);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 24px;
        display: flex;
        gap: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .search-input {
        flex: 1;
        padding: 10px 16px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 14px;
    }

    .item-image {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--border-color);
    }
</style>

<div class="breadcrumb-container">
    <div class="breadcrumb">
        <span class="breadcrumb-item"><a href="/" style="color: var(--text-light); text-decoration: none;">Home</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item active">Add-ons</span>
    </div>
</div>

<div class="page-header">
    <div>
        <h1 class="page-title">Add-ons Management</h1>
    </div>
    <div class="page-actions">
        <a href="@Url.Action("Create", "AddOns", new { area = "Admin" })" class="btn btn-primary">
            <span></span> Add New Add-on
        </a>
    </div>
</div>


<div class="table-container">
    @if (Model.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th style="width: 10%;">Icon</th>
                    <th style="width: 25%;">Add-on Name</th>
                    <th style="width: 30%;">Description</th>
                    <th style="width: 15%;">Price</th>
                    <th style="width: 10%;">Status</th>
                    <th style="width: 10%;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="@item.ImageUrl"
                                 alt="@item.AddOnName"
                                 class="item-image" />
                        </td>
                        <td>
                            <strong>@Html.DisplayFor(modelItem => item.AddOnName)</strong>
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>
                        <td>
                            <strong style="color: var(--primary-teal);">₹@Html.DisplayFor(modelItem => item.Price)</strong>
                        </td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge badge-active">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a href="@Url.Action("Edit", "AddOns", new { area = "Admin", id = item.AddOnId })" class="action-btn action-btn-edit" title="Edit">EDIT</a>
                                @* <a href="@Url.Action("Delete", "AddOns", new { area = "Admin", id = item.AddOnId })" class="action-btn action-btn-delete" title="Delete" onclick="return confirm('Are you sure?')">🗑️</a>  *@
                                <form action="/Admin/AddOns/Delete/@item.AddOnId"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure?');">

                                    <button type="submit"
                                            class="action-btn action-btn-delete"
                                            title="Delete">
                                        DELETE
                                    </button>

                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-title">No Add-ons Found</div>
            <p>Start by creating your first add-on option.</p>
            <a href="@Url.Action("Create")" class="btn btn-primary" style="margin-top: 16px;">Create Add-on</a>
        </div>
    }
</div>
