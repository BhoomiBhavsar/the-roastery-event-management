<!-- MENU ITEMS -->

<div class="section-card">

    <div class="section-title">
        Menu Items
    </div>

    @if (ViewBag.MenuItems.Count > 0)
    {
        var groupedMenuItems = ((IEnumerable<dynamic>)ViewBag.MenuItems)
        .GroupBy(x => x.MenuItem.Category);

        @foreach (var categoryGroup in groupedMenuItems)
        {
            <div style="margin-bottom:40px;">

                <h3 style="
                            color:#734120;
                            font-size:22px;
                            font-weight:700;
                            margin-bottom:20px;
                            padding-bottom:10px;
                            border-bottom:2px solid #E0C49F;">
                    @categoryGroup.Key
                </h3>

                <div class="item-grid">

                    @foreach (var item in categoryGroup)
                    {
                        <div class="item-card">

                            <img src="@item.MenuItem.ImageUrl"
                                 alt="@item.MenuItem.ItemName"
                                 class="item-image" />

                            <div class="item-body">

                                <div class="item-name">
                                    @item.MenuItem.ItemName
                                </div>

                                <div class="item-price">
                                    ₹@item.MenuItem.Price
                                </div>

                                <a href="/Admin/PackageInclusions/DeleteMenuItem/@item.Id"
                                   class="delete-btn"
                                   onclick="return confirm('Remove this menu item from package?')">
                                    DELETE
                                </a>

                            </div>

                        </div>
                    }

                </div>

            </div>
        }
    }
    else
    {
        <div class="empty-box">
            No Menu Items Added
        </div>
    }

</div>

<!-- ADDONS -->

<div class="section-card">

    <div class="section-title">
        AddOns
    </div>

    @if (ViewBag.AddOns.Count > 0)
    {
        <div class="item-grid">

            @foreach (var item in ViewBag.AddOns)
            {
                <div class="item-card">

                    <img src="@item.AddOn.ImageUrl"
                         alt="@item.AddOn.AddOnName"
                         class="item-image" />

                    <div class="item-body">

                        <div class="item-name">
                            @item.AddOn.AddOnName
                        </div>

                        <div class="item-price">
                            ₹@item.AddOn.Price
                        </div>

                        @if (!string.IsNullOrEmpty(item.AddOn.Description))
                        {
                            <p style="font-size:13px;color:#666;margin-bottom:12px;">
                                @item.AddOn.Description
                            </p>
                        }

                        <a href="/Admin/PackageInclusions/DeleteAddOn/@item.Id"
                           class="delete-btn"
                           onclick="return confirm('Remove this addon from package?')">
                            DELETE
                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-box">
            No AddOns Added
        </div>
    }

</div>

<!-- DECORATIONS -->

<div class="section-card">

    <div class="section-title">
        Decorations
    </div>

    @if (ViewBag.Decorations.Count > 0)
    {
        <div class="item-grid">

            @foreach (var item in ViewBag.Decorations)
            {
                <div class="item-card">

                    <img src="@item.Decoration.ImageUrl"
                         alt="@item.Decoration.DecorationName"
                         class="item-image" />

                    <div class="item-body">

                        <div class="item-name">
                            @item.Decoration.DecorationName
                        </div>

                        <div class="item-price">
                            ₹@item.Decoration.Price
                        </div>

                        <a href="/Admin/PackageInclusions/DeleteDecoration/@item.Id"
                           class="delete-btn"
                           onclick="return confirm('Remove this decoration from package?')">
                            DELETE
                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-box">
            No Decorations Added
        </div>
    }

</div>