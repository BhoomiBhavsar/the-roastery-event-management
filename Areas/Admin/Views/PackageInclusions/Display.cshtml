@{
    ViewData["Title"] = "Package Inclusions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var package = ViewBag.Package;
}

<style>
    .top-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .page-title {
        color: #734120;
        font-size: 32px;
        font-weight: 700;
        margin: 0;
    }

    .top-buttons {
        display: flex;
        gap: 10px;
    }

    .top-btn {
        background: #734120;
        color: white;
        padding: 12px 18px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s ease;
    }

        .top-btn:hover {
            background: #B5885E;
            color: white;
        }

    .section-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    }

    .section-title {
        color: #734120;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 20px;
        border-left: 5px solid #B5885E;
        padding-left: 14px;
    }

    .item-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(260px,1fr));
        gap: 22px;
    }

    .item-card {
        border: 1px solid #E0C49F;
        border-radius: 14px;
        overflow: hidden;
        background: #fffaf5;
        transition: 0.3s ease;
    }

        .item-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 16px rgba(0,0,0,0.12);
        }

    .item-image {
        width: 100%;
        height: 190px;
        object-fit: cover;
        border-bottom: 1px solid #E0C49F;
    }

    .item-body {
        padding: 18px;
    }

    .item-name {
        font-size: 18px;
        font-weight: 700;
        color: #734120;
        margin-bottom: 10px;
    }

    .item-price {
        color: #B5885E;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .item-category {
        display: inline-block;
        background: #E0C49F;
        color: #734120;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .delete-btn {
        display: inline-block;
        background: #734120;
        color: white;
        text-decoration: none;
        padding: 10px 15px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        transition: 0.3s ease;
    }

        .delete-btn:hover {
            background: #B5885E;
            color: white;
        }

    .empty-box {
        text-align: center;
        padding: 40px;
        background: #fffaf5;
        border: 1px dashed #B5885E;
        border-radius: 12px;
        color: #734120;
        font-size: 16px;
        font-weight: 600;
    }
</style>

<div class="top-section">

    <div>
        <h1 class="page-title">
            @package.PackageName Inclusions
        </h1>
    </div>

    <div class="top-buttons">

        <a href="/Admin/PackageInclusions/Add/@package.PackageId"
           class="top-btn">
            ADD INCLUSIONS
        </a>

        <a href="/Admin/PackageInclusions/Edit/@package.PackageId"
           class="top-btn">
            EDIT INCLUSIONS
        </a>

    </div>

</div>

