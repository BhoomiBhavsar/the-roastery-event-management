@model EventMVC.Models.EventPackage
@using Microsoft.AspNetCore.Mvc.Rendering;

@{
    ViewData["Title"] = "Edit Event Package";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .form-container {
        max-width: 600px;
    }

    .form-card {
        background: var(--white);
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .form-actions .btn {
        flex: 1;
    }

    .validation-message {
        color: var(--danger);
        font-size: 12px;
        margin-top: 6px;
    }

    .input-group {
        position: relative;
    }

    .input-icon {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        pointer-events: none;
    }

    .form-control.with-icon {
        padding-right: 45px;
    }

    .edit-badge {
        display: inline-block;
        background-color: var(--primary-light);
        color: var(--primary-dark);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-left: 8px;
    }

    .form-select {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s ease;
        font-family: inherit;
    }

    .form-select:focus {
        outline: none;
        border-color: var(--primary-teal);
        box-shadow: 0 0 0 3px rgba(15, 164, 175, 0.1);
    }
</style>

<div class="breadcrumb-container">
    <div class="breadcrumb">
        <span class="breadcrumb-item"><a href="/" style="color: var(--text-light); text-decoration: none;">Home</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item"><a href="/Admin/EventPackages" style="color: var(--text-light); text-decoration: none;">Event Packages</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item active">Edit</span>
    </div>
</div>

<div class="page-header">
    <div>
        <h1 class="page-title"> Edit Event Package <span class="edit-badge">ID: @Model.PackageId</span></h1>
    </div>
</div>




<div class="form-container">
    <div class="form-card">

        <form asp-controller="EventPackages"
              asp-action="Edit"
              asp-route-id="@Model.PackageId"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="PackageId" value="@Model.PackageId">

            <div class="form-group">
                <label class="form-label">Package Name </label>

                <div class="input-group">
                    <input name="PackageName"
                           value="@Model.PackageName"
                           class="form-control with-icon"
                           placeholder="e.g., Silver Birthday Package, Premium Wedding Package">

                </div>

                <span class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Event Type *</label>

                <select name="EventTypeId" class="form-select">
                    @foreach (EventMVC.Models.EventType item in ViewBag.EventTypeId)
                    {
                        if (item.EventTypeId == Model.EventTypeId)
                        {
                            <option value="@item.EventTypeId" selected>
                                @item.Name
                            </option>
                        }
                        else
                        {
                            <option value="@item.EventTypeId">
                                @item.Name
                            </option>
                        }
                    }

                </select>

                <span class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Description</label>

                <textarea name="Description"
                          class="form-control"
                          rows="4"
                          placeholder="Provide a detailed description of this package...">@Model.Description</textarea>

                <span class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Price Per Guest</label>

                <div class="input-group">
                    <input name="PricePerGuest"
                           value="@Model.PricePerGuest"
                           class="form-control with-icon"
                           type="number"
                           placeholder="e.g., 1500"
                           min="0"
                           step="0.01">

                </div>

                <span class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Image URL</label>

                <div class="input-group">
                    <input name="ImageUrl"
                           value="@Model.ImageUrl"
                           class="form-control with-icon"
                           placeholder="https://example.com/image.jpg">

                </div>

                <span class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label">
                    <input type="checkbox"
                           name="IsActive"
                           value="true"
                           @(Model.IsActive ? "checked" : "")
                           style="margin-right: 8px; cursor: pointer;">

                    Active Status
                </label>

                <p style="color: var(--text-light); font-size: 12px; margin-top: 6px;">
                    Enable this package for booking
                </p>
            </div>

            <div class="form-actions">
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>
            </div>

        </form>

    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
