@model EventMVC.Models.EventPackage

@{
    ViewData["Title"] = "Delete Event Package";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .delete-container {
        max-width: 500px;
    }

    .delete-card {
        background: var(--white);
        border-radius: 12px;
        padding: 40px 30px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        border-left: 4px solid var(--danger);
    }

    .delete-icon {
        font-size: 48px;
        text-align: center;
        margin-bottom: 20px;
    }

    .delete-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--primary-dark);
        margin-bottom: 8px;
        text-align: center;
    }

    .delete-message {
        color: var(--text-light);
        text-align: center;
        margin-bottom: 24px;
    }

    .detail-box {
        background-color: var(--light-bg);
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 24px;
        border-left: 3px solid var(--primary-teal);
    }

    .detail-label {
        color: var(--text-light);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .detail-value {
        font-size: 16px;
        font-weight: 600;
        color: var(--primary-dark);
    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .form-actions .btn {
        flex: 1;
    }

    .warning-message {
        background-color: rgba(245, 158, 11, 0.15);
        border: 1px solid var(--warning);
        color: var(--warning);
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 24px;
        font-size: 13px;
    }
</style>

<div class="breadcrumb-container">
    <div class="breadcrumb">
        <span class="breadcrumb-item"><a href="/" style="color: var(--text-light); text-decoration: none;">Home</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item"><a href="/Admin/EventPackages" style="color: var(--text-light); text-decoration: none;">Event Packages</a></span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item active">Delete</span>
    </div>
</div>

<div class="page-header">
    <div>
        <h1 class="page-title"> Delete Event Package</h1>
    </div>
</div>

<div class="delete-container">
    <div class="delete-card">
        <div class="delete-icon">⚠️</div>
        <div class="delete-title">Confirm Deletion</div>
        <p class="delete-message">You are about to permanently delete this event package and all related data.</p>

        <div class="warning-message">
             Warning: This action is permanent and cannot be reversed. Please ensure you want to delete this record.
        </div>

        <div class="detail-box">
            <div class="detail-label">Package Name</div>
            <div class="detail-value">@Html.DisplayFor(model => model.PackageName)</div>
        </div>

        <div class="detail-box">
            <div class="detail-label">Event Type</div>
            <div class="detail-value">@Html.DisplayFor(model => model.EventType.Name)</div>
        </div>

        <div class="detail-box">
            <div class="detail-label">Price Per Guest</div>
            <div class="detail-value">₹@Html.DisplayFor(model => model.PricePerGuest)</div>
        </div>

        <div class="detail-box">
            <div class="detail-label">Status</div>
            <div class="detail-value">
                @if (Model.IsActive)
                {
                    <span class="badge badge-active">Active</span>
                }
                else
                {
                    <span class="badge badge-inactive">Inactive</span>
                }
            </div>
        </div>
        <form asp-action="Delete" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.PackageId" />

            <div class="form-actions">
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                     Cancel
                </a>

                <button type="submit" class="btn btn-danger">
                     Delete Permanently
                </button>
            </div>
        </form>
    </div>
</div>
