@model EventMVC.Models.Inquiry

@{
    ViewData["Title"] = "Reply Inquiry";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .reply-container {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 25px;
        margin-top: 20px;
    }

    .info-card, .reply-card {
        background: var(--white);
        border-radius: 15px;
        box-shadow: 0 5px 20px rgba(0,0,0,.06);
        border: 1px solid var(--border-color);
        overflow: hidden;
    }

    .card-header {
        padding: 18px 22px;
        background: linear-gradient(135deg, var(--primary-dark), var(--primary-teal));
        color: white;
        font-weight: 600;
        font-size: 16px;
    }

    .card-body {
        padding: 22px;
    }

    .info-row {
        margin-bottom: 12px;
        color: var(--text-dark);
        font-size: 14px;
    }

        .info-row strong {
            color: var(--primary-dark);
            min-width: 90px;
            display: inline-block;
        }

    .message-box {
        margin-top: 10px;
        padding: 15px;
        background: rgba(224,196,159,.15);
        border-left: 4px solid var(--primary-teal);
        border-radius: 10px;
        color: var(--text-dark);
    }

    .reply-item {
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 12px;
        background: var(--light-bg);
        border: 1px solid var(--border-color);
    }

        .reply-item small {
            color: var(--text-light);
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        margin-top: 8px;
        transition: .3s;
    }

        .form-control:focus {
            border-color: var(--primary-teal);
            outline: none;
            box-shadow: 0 0 0 3px rgba(181,136,94,.15);
        }

    .btn-send {
        margin-top: 15px;
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--primary-dark), var(--primary-teal));
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: .3s;
    }

        .btn-send:hover {
            transform: translateY(-2px);
        }

    .badge-status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .pending {
        background: #FFF3CD;
        color: #856404;
    }

    .answered {
        background: #D4EDDA;
        color: #155724;
    }

    @@media(max-width: 900px) {
        .reply-container {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Reply Inquiry</h1>
        <p class="page-subtitle">View details and respond to customer message</p>
    </div>
</div>

<div class="reply-container">

    <!-- LEFT: Inquiry Info -->
    <div class="info-card">

        <div class="card-header">
            Inquiry Details
        </div>

        <div class="card-body">

            <div class="info-row">
                <strong>Name:</strong> @Model.Name
            </div>

            <div class="info-row">
                <strong>Email:</strong> @Model.Email
            </div>

            <div class="info-row">
                <strong>Phone:</strong> @Model.PhoneNumber
            </div>

            <div class="info-row">
                <strong>Event:</strong> @Model.EventType?.Name
            </div>

            <div class="info-row">
                <strong>Guests:</strong> @Model.GuestCount
            </div>

            <div class="info-row">
                <strong>Status:</strong>

                @if (Model.Status == "Answered")
                {
                    <span class="badge-status answered">Answered</span>
                }
                else
                {
                    <span class="badge-status pending">Pending</span>
                }
            </div>

            <div class="message-box">
                @Model.Message
            </div>

        </div>
    </div>

    <!-- RIGHT: Reply Section -->
    <div class="reply-card">

        <div class="card-header">
            Send Reply
        </div>

        <div class="card-body">

            <h4 style="color:var(--primary-dark); margin-bottom:10px;">
                Previous Replies
            </h4>

            @if (Model.InquiryReplies != null && Model.InquiryReplies.Any())
            {
                foreach (var reply in Model.InquiryReplies)
                {
                    <div class="reply-item">
                        <strong>@reply.RepliedBy</strong><br />
                        @reply.ReplyMessage<br />
                        <small>@reply.RepliedAt</small>
                    </div>
                }
            }
            else
            {
                <p style="color:var(--text-light);">No replies yet.</p>
            }

            <hr />

            <form method="post">

                <input type="hidden" name="inquiryId" value="@Model.InquiryId" />

                <label>Reply Message</label>
                <textarea name="replyMessage" rows="5" class="form-control" required></textarea>

                <button type="submit" class="btn-send">
                    Send Reply
                </button>

            </form>

        </div>
    </div>

</div>