@model IEnumerable<EventMVC.Models.Inquiry>

@{
    ViewData["Title"] = "Inquiry Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .message-cell {
        max-width: 300px;
        white-space: normal;
        word-wrap: break-word;
        color: var(--text-light);
    }

    .stats-card {
        background: var(--white);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 24px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        border-left: 4px solid var(--primary-teal);
    }

    .stats-number {
        font-size: 28px;
        font-weight: 700;
        color: var(--primary-dark);
    }

    .stats-label {
        color: var(--text-light);
        font-size: 14px;
    }

    .badge-pending {
        background: #FFF3CD;
        color: #856404;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .badge-answered {
        background: #D4EDDA;
        color: #155724;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .reply-btn {
        background: var(--primary-teal);
        color: white !important;
        padding: 8px 16px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .3s;
    }

        .reply-btn:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }
</style>

<div class="breadcrumb-container">
    <div class="breadcrumb">
        <span class="breadcrumb-item">
            <a href="/" style="color: var(--text-light); text-decoration:none;">
                Home
            </a>
        </span>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-item active">
            Inquiries
        </span>
    </div>
</div>

<div class="page-header">
    <div>
        <h1 class="page-title">Inquiry Management</h1>
        <p class="page-subtitle">
            View and respond to customer inquiries
        </p>
    </div>
</div>

<div class="stats-card">
    <div class="stats-number">@Model.Count()</div>
    <div class="stats-label">Total Inquiries</div>
</div>

<div class="table-container">

    @if (Model.Any())
    {
        <table class="table">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Event Type</th>
                    <th>Guests</th>
                    <th>Message</th>
                    <th>Status</th>
                    <th style="width:120px;">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <strong>@item.Name</strong>
                        </td>

                        <td>@item.Email</td>

                        <td>
                            @(item.EventType?.Name ?? "-")
                        </td>

                        <td>
                            <span style="
                                        background: var(--primary-light);
                                        color: var(--primary-dark);
                                        padding:4px 12px;
                                        border-radius:20px;
                                        font-size:12px;
                                        font-weight:600;">
                                @item.GuestCount Guests
                            </span>
                        </td>

                        <td class="message-cell">
                            @item.Message
                        </td>

                        <td>
                            @if (item.Status == "Answered")
                            {
                                <span class="badge-answered">
                                    Answered
                                </span>
                            }
                            else
                            {
                                <span class="badge-pending">
                                    Pending
                                </span>
                            }
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a href="@Url.Action("Reply", "Inquiries", new { area = "Admin", id = item.InquiryId })"
                                   class="reply-btn">
                                    Reply
                                </a>
                            </div>
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-title">
                No Inquiries Found
            </div>
            <p>
                No customer inquiries have been submitted yet.
            </p>
        </div>
    }

</div>