@model EventMVC.Models.EventBooking

<h1>Booking Submitted Successfully</h1>

<p>
    Booking ID:
    @Model.BookingId
</p>

<p>
    Event:
    @Model.EventType?.Name
</p>

<p>
    Status:
    @Model.BookingStatus
</p>

<p>
    Total:
    ₹@Model.TotalAmount
</p>

<a asp-action="MyBookings">
    View My Bookings
</a>