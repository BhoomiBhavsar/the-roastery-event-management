@* @model EventMVC.Models.EventPackage

@{
    ViewData["Title"] = Model.PackageName;

    var groupedMenuItems = Model.PackageMenuItems?
        .Where(x => x.MenuItem != null)
        .GroupBy(x => x.MenuItem.Category)
        .OrderBy(x => x.Key);
}

<style>

    body {
        background: #f7f3ee;
    }

    .package-wrapper {
        max-width: 1600px;
        margin: auto;
        padding: 2rem;
    }

    /* BREADCRUMB */

    .custom-breadcrumb {
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

        .custom-breadcrumb a {
            text-decoration: none;
            color: #734126;
            font-weight: 600;
        }

        .custom-breadcrumb span {
            color: #777;
        }

    /* MAIN LAYOUT */

    .package-layout {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 2.5rem;
        align-items: start;
    }

    /* SIDEBAR */

    .package-sidebar {
        position: sticky;
        top: 20px;
    }

    .sidebar-card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(43,20,8,0.08);
    }

    .sidebar-image {
        width: 100%;
        height: 300px;
        overflow: hidden;
    }

        .sidebar-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .sidebar-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg,#452816,#734126);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 5rem;
        color: white;
    }

    .sidebar-content {
        padding: 2rem;
    }

    .package-type {
        display: inline-block;
        background: #E0C49F;
        color: #2B1408;
        padding: 0.45rem 1rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .sidebar-content h1 {
        color: #2B1408;
        font-size: 2rem;
        margin-bottom: 1rem;
        font-weight: 800;
        line-height: 1.3;
    }

    .sidebar-description {
        color: #666;
        line-height: 1.9;
        margin-bottom: 2rem;
    }

    .price-box {
        background: linear-gradient(135deg,#452816,#734126);
        border-radius: 20px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        color: white;
    }

        .price-box small {
            color: #E0C49F;
            letter-spacing: 1px;
        }

        .price-box h2 {
            margin-top: 0.5rem;
            font-size: 2.7rem;
            font-weight: 800;
        }

    .quick-info {
        margin-bottom: 2rem;
    }

    .quick-info-item {
        display: flex;
        justify-content: space-between;
        padding: 0.9rem 0;
        border-bottom: 1px solid #eee;
    }

        .quick-info-item span:first-child {
            color: #777;
        }

        .quick-info-item span:last-child {
            font-weight: 700;
            color: #2B1408;
        }

    .sidebar-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .btn-premium {
        text-align: center;
        padding: 1rem;
        border-radius: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s ease;
    }

    .btn-book {
        background: #734126;
        color: white;
    }

        .btn-book:hover {
            background: #2B1408;
            color: #E0C49F;
            transform: translateY(-2px);
        }

    .btn-back {
        background: #E0C49F;
        color: #2B1408;
    }

        .btn-back:hover {
            background: #d6b487;
            color: #2B1408;
        }

    /* CONTENT AREA */

    .content-area {
        display: flex;
        flex-direction: column;
        gap: 4rem;
    }

    /* SECTION TITLE */

    .section-header {
        margin-bottom: 1.8rem;
    }

        .section-header h2 {
            color: #2B1408;
            font-size: 2rem;
            font-weight: 800;
            margin-bottom: 0.5rem;
        }

        .section-header p {
            color: #777;
        }

    /* CATEGORY */

    .category-block {
        margin-bottom: 3rem;
    }

    .category-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.3rem;
    }

        .category-title h3 {
            color: #2B1408;
            font-size: 1.4rem;
            font-weight: 800;
        }

    .category-line {
        flex: 1;
        height: 2px;
        background: linear-gradient(to right,#734126,transparent);
        margin-left: 1rem;
    }

    /* HORIZONTAL CARDS */

    .horizontal-scroll {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        padding-bottom: 1rem;
        scrollbar-width: thin;
    }

        .horizontal-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .horizontal-scroll::-webkit-scrollbar-thumb {
            background: #734126;
            border-radius: 10px;
        }

    .food-card {
        min-width: 270px;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(43,20,8,0.07);
        transition: 0.35s ease;
        flex-shrink: 0;
    }

        .food-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(43,20,8,0.14);
        }

    .food-image {
        height: 200px;
        overflow: hidden;
        background: #f5efe7;
    }

        .food-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.4s ease;
        }

    .food-card:hover img {
        transform: scale(1.08);
    }

    .food-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg,#E0C49F,#734126);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: white;
    }

    .food-content {
        padding: 1.2rem;
    }

        .food-content h4 {
            color: #2B1408;
            font-weight: 700;
            margin-bottom: 0.6rem;
        }

    .food-price {
        color: #734126;
        font-weight: 800;
        font-size: 1rem;
    }

    /* GALLERY */

    .gallery-grid {
        columns: 3 280px;
        column-gap: 1.5rem;
    }

    .gallery-card {
        background: white;
        border-radius: 24px;
        overflow: hidden;
        margin-bottom: 1.5rem;
        break-inside: avoid;
        box-shadow: 0 10px 30px rgba(43,20,8,0.08);
    }

    .gallery-image img {
        width: 100%;
        display: block;
    }

    .gallery-content {
        padding: 1.3rem;
    }

        .gallery-content h4 {
            color: #2B1408;
            font-weight: 700;
            margin-bottom: 0.6rem;
        }

    .gallery-price {
        color: #734126;
        font-weight: 800;
    }

    /* ADDONS */

    .addon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(300px,1fr));
        gap: 2rem;
    }

    .addon-card {
        background: white;
        border-radius: 26px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(43,20,8,0.08);
        transition: 0.3s ease;
    }

        .addon-card:hover {
            transform: translateY(-8px);
        }

    .addon-image {
        height: 240px;
    }

        .addon-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .addon-content {
        padding: 1.5rem;
    }

        .addon-content h4 {
            color: #2B1408;
            font-weight: 800;
            margin-bottom: 0.8rem;
        }

        .addon-content p {
            color: #777;
            line-height: 1.8;
            margin-bottom: 1rem;
        }

    .addon-price {
        color: #734126;
        font-weight: 800;
    }


</style>

<div class="package-wrapper">

    <!-- BREADCRUMB -->

    <div class="custom-breadcrumb">

        <a asp-controller="EventTypes" asp-action="Index">
            Event Types
        </a>

        <span> / </span>

        <a asp-controller="EventTypes"
           asp-action="Packages"
           asp-route-id="@Model.EventTypeId">

            @Model.EventType?.Name
        </a>

        <span> / @Model.PackageName</span>

    </div>

    <!-- MAIN LAYOUT -->

    <div class="package-layout">

        <!-- LEFT SIDEBAR -->

        <div class="package-sidebar">

            <div class="sidebar-card">

                <div class="sidebar-image">

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.PackageName">
                    }
                    else
                    {
                        <div class="sidebar-placeholder">
                            📦
                        </div>
                    }

                </div>

                <div class="sidebar-content">

                    <div class="package-type">
                        @Model.EventType?.Name Package
                    </div>

                    <h1>
                        @Model.PackageName
                    </h1>

                    <div class="sidebar-description">
                        @Model.Description
                    </div>

                    <div class="price-box">

                        <small>STARTING FROM</small>

                        <h2>
                            ₹@Model.PricePerGuest
                        </h2>

                    </div>

                    <div class="quick-info">

                        <div class="quick-info-item">
                            <span>Menu Items</span>
                            <span>@Model.PackageMenuItems.Count()</span>
                        </div>

                        <div class="quick-info-item">
                            <span>Decorations</span>
                            <span>@Model.PackageDecorations.Count()</span>
                        </div>

                        <div class="quick-info-item">
                            <span>Add-ons</span>
                            <span>@Model.PackageAddOns.Count()</span>
                        </div>

                    </div>

                    <div class="sidebar-buttons">

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="EventBookings"
                               asp-action="BookPredefined"
                               asp-route-packageId="@Model.PackageId"
                               class="btn-premium btn-book">

                                Book This Package
                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-controller="Account"
                               asp-action="Login"
                               class="btn-premium btn-book">

                                Login To Book
                            </a>
                        }

                        <a asp-controller="EventTypes"
                           asp-action="Packages"
                           asp-route-id="@Model.EventTypeId"
                           class="btn-premium btn-back">

                            Back To Packages
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- RIGHT CONTENT -->

        <div class="content-area">

            <!-- MENU -->
            @if (groupedMenuItems != null && groupedMenuItems.Any())
            {
                <div>

                    <div class="section-header">

                        <h2>🍽 Culinary Experience</h2>

                        <p>
                            Curated menu selections crafted for unforgettable celebrations.
                        </p>

                    </div>

                    @foreach (var category in groupedMenuItems)
                    {
                        <div class="category-block">

                            <div class="category-title">

                                <h3>@category.Key</h3>

                                <div class="category-line"></div>

                            </div>

                            <div class="horizontal-scroll">

                                @foreach (var item in category)
                                {
                                    <div class="food-card">

                                        <div class="food-image">

                                            @if (!string.IsNullOrEmpty(item.MenuItem?.ImageUrl))
                                            {
                                                <img src="@item.MenuItem.ImageUrl">
                                            }
                                            else
                                            {
                                                <div class="food-placeholder">
                                                    🍽️
                                                </div>
                                            }

                                        </div>

                                        <div class="food-content">

                                            <h4>
                                                @item.MenuItem?.ItemName
                                            </h4>

                                            <div class="food-price">
                                                ₹@item.MenuItem?.Price
                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>
                    }

                </div>
            }

            <!-- DECORATIONS -->
            @if (Model.PackageDecorations.Any())
            {
                <div>

                    <div class="section-header">

                        <h2>🎨 Decoration Gallery</h2>

                        <p>
                            Elegant ambience and luxurious setups tailored for your celebration.
                        </p>

                    </div>

                    <div class="gallery-grid">

                        @foreach (var decoration in Model.PackageDecorations)
                        {
                            <div class="gallery-card">

                                <div class="gallery-image">

                                    @if (!string.IsNullOrEmpty(decoration.Decoration?.ImageUrl))
                                    {
                                        <img src="@decoration.Decoration.ImageUrl">
                                    }
                                    else
                                    {
                                        <div class="food-placeholder">
                                            🎨
                                        </div>
                                    }

                                </div>

                                <div class="gallery-content">

                                    <h4>
                                        @decoration.Decoration?.DecorationName
                                    </h4>

                                    <div class="gallery-price">
                                        ₹@decoration.Decoration?.Price
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

            <!-- ADDONS -->
            @if (Model.PackageAddOns.Any())
            {
                <div>

                    <div class="section-header">

                        <h2>✨ Exclusive Add-ons</h2>

                        <p>
                            Enhance your event experience with premium additional services.
                        </p>

                    </div>

                    <div class="addon-grid">

                        @foreach (var addon in Model.PackageAddOns)
                        {
                            <div class="addon-card">

                                <div class="addon-image">

                                    @if (!string.IsNullOrEmpty(addon.AddOn?.ImageUrl))
                                    {
                                        <img src="@addon.AddOn.ImageUrl">
                                    }
                                    else
                                    {
                                        <div class="food-placeholder">
                                            ✨
                                        </div>
                                    }

                                </div>

                                <div class="addon-content">

                                    <h4>
                                        @addon.AddOn?.AddOnName
                                    </h4>

                                    <p>
                                        @addon.AddOn?.Description
                                    </p>

                                    <div class="addon-price">
                                        ₹@addon.AddOn?.Price
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>


</div> *@



@model EventMVC.Models.EventPackage

@{
    ViewData["Title"] = Model.PackageName + " - Elite Events";

    var groupedMenuItems = Model.PackageMenuItems?
        .Where(x => x.MenuItem != null)
        .GroupBy(x => x.MenuItem.Category)
        .OrderBy(x => x.Key);
}

<style>

    body {
        background: #f7f4ef;
        overflow-x: hidden;
    }

    .package-page {
        width: 100%;
        overflow-x: hidden;
    }

    /* HERO */

    .hero-section {
        position: relative;
        height: 88vh;
        overflow: hidden;
    }

        .hero-section img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient( to right, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.72) 35%, rgba(0,0,0,0.45) 65%, rgba(0,0,0,0.30) 100% ), linear-gradient( to top, rgba(0,0,0,0.55), transparent 45% );
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 7%;
        transform: translateY(-50%);
        color: white;
        max-width: 700px;
        z-index: 2;
    }

    .hero-badge {
        display: inline-block;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        backdrop-filter: blur(12px);
        color: white;
        padding: 0.7rem 1.3rem;
        border-radius: 50px;
        font-weight: 700;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 25px rgba(0,0,0,0.25);
    }

    .hero-content h1 {
        font-size: 4.5rem;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        font-weight: 900;
        color: white;
        text-shadow: 0 4px 18px rgba(0,0,0,0.55), 0 2px 8px rgba(0,0,0,0.45);
    }

    .hero-description {
        line-height: 2;
        color: rgba(255,255,255,0.92);
        font-size: 1.05rem;
        margin-bottom: 2rem;
        max-width: 650px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.45);
    }

    .hero-bottom {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .hero-price {
        background: rgba(0,0,0,0.35);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(255,255,255,0.15);
        padding: 1rem 1.5rem;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.30);
    }

        .hero-price small {
            color: #E0C49F;
            letter-spacing: 1px;
        }

        .hero-price h2 {
            margin-top: 0.3rem;
            font-size: 2.5rem;
            font-weight: 800;
            color: white;
        }

    .hero-buttons {
        display: flex;
        gap: 1rem;
    }

    .btn-premium {
        padding: 1rem 1.8rem;
        border-radius: 14px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s ease;
    }

    .btn-book {
        background: #734126;
        color: white;
    }

        .btn-book:hover {
            background: #E0C49F;
            color: #2B1408;
            transform: translateY(-3px);
            text-decoration: none;
        }

    .btn-back {
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.18);
        color: white;
        backdrop-filter: blur(10px);
    }

        .btn-back:hover {
            background: white;
            color: #2B1408;
            text-decoration: none;
        }

    /* STATS */

    .stats-wrapper {
        margin-top: -70px;
        position: relative;
        z-index: 10;
        padding: 0 5%;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 1.5rem;
    }

    .stat-card {
        background: rgba(255,255,255,0.88);
        backdrop-filter: blur(15px);
        border-radius: 24px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 10px 35px rgba(43,20,8,0.08);
    }

        .stat-card h3 {
            color: #734126;
            font-size: 2.3rem;
            margin-bottom: 0.6rem;
            font-weight: 800;
        }

        .stat-card p {
            margin: 0;
            color: #666;
        }

    /* COMMON */

    .section {
        padding: 6rem 5%;
    }

    .section-light {
        background: white;
    }

    .section-beige {
        background: #f7f4ef;
    }

    .section-title {
        margin-bottom: 3rem;
    }

        .section-title h2 {
            font-size: 3rem;
            color: #2B1408;
            font-weight: 900;
            margin-bottom: 1rem;
        }

        .section-title p {
            color: #777;
            line-height: 2;
            max-width: 750px;
        }

    /* MENU */

    .menu-category {
        margin-bottom: 4rem;
    }

    .menu-category-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }

        .menu-category-title h3 {
            color: #2B1408;
            font-size: 1.9rem;
            font-weight: 800;
            white-space: nowrap;
        }

    .menu-line {
        flex: 1;
        height: 2px;
        background: linear-gradient(to right,#734126,transparent);
    }

    .menu-layout {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 2rem;
    }

    .menu-item {
        display: flex;
        gap: 1.3rem;
        background: white;
        border-radius: 24px;
        padding: 1rem;
        box-shadow: 0 10px 30px rgba(43,20,8,0.06);
        transition: 0.3s ease;
    }

        .menu-item:hover {
            transform: translateY(-6px);
        }

    .menu-item-image {
        width: 150px;
        height: 150px;
        border-radius: 18px;
        overflow: hidden;
        flex-shrink: 0;
        background: #f5efe7;
    }

        .menu-item-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .menu-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg,#E0C49F,#734126);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2rem;
    }

    .menu-item-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .menu-item-content h4 {
            color: #2B1408;
            margin-bottom: 0.7rem;
            font-weight: 800;
        }

        .menu-item-content p {
            color: #777;
            line-height: 1.8;
            margin-bottom: 0.7rem;
        }

    .menu-price {
        color: #734126;
        font-weight: 800;
        font-size: 1.05rem;
    }

    /* DECOR */

    .decor-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 1.5rem;
    }

    .decor-card {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        min-height: 430px;
        box-shadow: 0 15px 40px rgba(43,20,8,0.10);
    }

        .decor-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .decor-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.85), transparent);
    }

    .decor-content {
        position: absolute;
        bottom: 0;
        padding: 2rem;
        color: white;
    }

        .decor-content h4 {
            font-size: 1.6rem;
            font-weight: 800;
            margin-bottom: 0.8rem;
        }

    .decor-price {
        color: #E0C49F;
        font-weight: 700;
    }

    /* ADDONS */

    .addon-layout {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 2rem;
    }

    .addon-card {
        background: white;
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(43,20,8,0.08);
        transition: 0.3s ease;
    }

        .addon-card:hover {
            transform: translateY(-8px);
        }

    .addon-image {
        height: 240px;
        overflow: hidden;
    }

        .addon-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .addon-content {
        padding: 1.5rem;
    }

        .addon-content h4 {
            color: #2B1408;
            margin-bottom: 1rem;
            font-weight: 800;
        }

        .addon-content p {
            color: #777;
            line-height: 1.8;
            margin-bottom: 1rem;
        }

    .addon-price {
        color: #734126;
        font-weight: 800;
    }

    /* BOOKING */

    .booking-section {
        padding: 6rem 5%;
    }

    .booking-card {
        position: relative;
        overflow: hidden;
        border-radius: 38px;
        background: linear-gradient(135deg,#452816,#734126);
        padding: 5rem;
        text-align: center;
        color: white;
    }

        .booking-card::before {
            content: "";
            position: absolute;
            width: 450px;
            height: 450px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            top: -180px;
            right: -100px;
        }

        .booking-card h2 {
            position: relative;
            font-size: 3rem;
            font-weight: 900;
            margin-bottom: 1.5rem;
        }

        .booking-card p {
            position: relative;
            max-width: 850px;
            margin: auto auto 2rem;
            line-height: 2;
            color: rgba(255,255,255,0.88);
        }

    .booking-btn {
        position: relative;
        display: inline-block;
        background: #E0C49F;
        color: #2B1408;
        padding: 1rem 2.5rem;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 800;
        transition: 0.3s ease;
    }

        .booking-btn:hover {
            background: white;
            color: #2B1408;
            transform: translateY(-4px);
            text-decoration: none;
        }
</style>

<div class="package-page">

    <!-- HERO -->

    <section class="hero-section">

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.PackageName">
        }
        else
        {
            <div class="menu-placeholder" style="height:100%;">
                📦
            </div>
        }

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <div class="hero-badge">
                @Model.EventType?.Name Package
            </div>

            <h1>
                @Model.PackageName
            </h1>

            <div class="hero-description">
                @Model.Description
            </div>

            <div class="hero-bottom">

                <div class="hero-price">
                    <small>STARTING FROM</small>
                    <h2>₹@Model.PricePerGuest</h2>
                </div>

                <div class="hero-buttons">

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="EventBookings"
                           asp-action="BookPredefined"
                           asp-route-packageId="@Model.PackageId"
                           class="btn-premium btn-book">

                            Book This Package
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-controller="Account"
                           asp-action="Login"
                           class="btn-premium btn-book">

                            Login To Book
                        </a>
                    }

                    <a asp-controller="EventTypes"
                       asp-action="Packages"
                       asp-route-id="@Model.EventTypeId"
                       class="btn-premium btn-back">

                        Back To Packages
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- STATS -->

    <div class="stats-wrapper">

        <div class="stats-grid">

            <div class="stat-card">
                <h3>@Model.PackageMenuItems.Count()</h3>
                <p>Menu Items</p>
            </div>

            <div class="stat-card">
                <h3>@Model.PackageDecorations.Count()</h3>
                <p>Decorations</p>
            </div>

            <div class="stat-card">
                <h3>@Model.PackageAddOns.Count()</h3>
                <p>Add-ons</p>
            </div>

            <div class="stat-card">
                <h3>Premium</h3>
                <p>Experience</p>
            </div>

        </div>

    </div>

    <!-- MENU -->
    @if (groupedMenuItems != null && groupedMenuItems.Any())
    {
        <section class="section section-light">

            <div class="section-title">

                <h2>🍽 Culinary Experience</h2>

                <p>
                    Carefully curated dishes designed to elevate your celebration experience.
                </p>

            </div>

            @foreach (var category in groupedMenuItems)
            {
                <div class="menu-category">

                    <div class="menu-category-title">

                        <h3>@category.Key</h3>

                        <div class="menu-line"></div>

                    </div>

                    <div class="menu-layout">

                        @foreach (var item in category)
                        {
                            <div class="menu-item">

                                <div class="menu-item-image">

                                    @if (!string.IsNullOrEmpty(item.MenuItem?.ImageUrl))
                                    {
                                        <img src="@item.MenuItem.ImageUrl">
                                    }
                                    else
                                    {
                                        <div class="menu-placeholder">
                                            🍽️
                                        </div>
                                    }

                                </div>

                                <div class="menu-item-content">

                                    <h4>@item.MenuItem?.ItemName</h4>

                                    <p>
                                        Premium prepared specialty for your event guests.
                                    </p>

                                    <div class="menu-price">
                                        ₹@item.MenuItem?.Price
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

        </section>
    }

    <!-- DECORATIONS -->
    @if (Model.PackageDecorations.Any())
    {
        <section class="section section-beige">

            <div class="section-title">

                <h2>🎨 Decoration Experience</h2>

                <p>
                    Elegant themes and luxurious ambience crafted for unforgettable celebrations.
                </p>

            </div>

            <div class="decor-grid">

                @foreach (var decoration in Model.PackageDecorations)
                {
                    <div class="decor-card">

                        @if (!string.IsNullOrEmpty(decoration.Decoration?.ImageUrl))
                        {
                            <img src="@decoration.Decoration.ImageUrl">
                        }
                        else
                        {
                            <div class="menu-placeholder" style="height:100%;">
                                🎨
                            </div>
                        }

                        <div class="decor-overlay"></div>

                        <div class="decor-content">

                            <h4>
                                @decoration.Decoration?.DecorationName
                            </h4>

                            <div class="decor-price">
                                ₹@decoration.Decoration?.Price
                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>
    }

    <!-- ADDONS -->
    @if (Model.PackageAddOns.Any())
    {
        <section class="section section-light">

            <div class="section-title">

                <h2>✨ Exclusive Add-ons</h2>

                <p>
                    Enhance your event with premium experiences and unforgettable moments.
                </p>

            </div>

            <div class="addon-layout">

                @foreach (var addon in Model.PackageAddOns)
                {
                    <div class="addon-card">

                        <div class="addon-image">

                            @if (!string.IsNullOrEmpty(addon.AddOn?.ImageUrl))
                            {
                                <img src="@addon.AddOn.ImageUrl">
                            }
                            else
                            {
                                <div class="menu-placeholder" style="height:100%;">
                                    ✨
                                </div>
                            }

                        </div>

                        <div class="addon-content">

                            <h4>
                                @addon.AddOn?.AddOnName
                            </h4>

                            <p>
                                @addon.AddOn?.Description
                            </p>

                            <div class="addon-price">
                                ₹@addon.AddOn?.Price
                            </div>

                        </div>

                    </div>
                }

            </div>

        </section>
    }

    <!-- BOOKING -->

    <section class="booking-section">

        <div class="booking-card">

            <h2>
                Ready To Create An Unforgettable Celebration?
            </h2>

            <p>
                Book your premium event package today and let Elite Events craft
                a luxurious experience tailored perfectly for your special occasion.
            </p>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-controller="EventBookings"
                   asp-action="BookPredefined"
                   asp-route-packageId="@Model.PackageId"
                   class="booking-btn">

                    Proceed To Booking
                </a>
            }
            else
            {
                <a asp-area="Identity"
                   asp-controller="Account"
                   asp-action="Login"
                   class="booking-btn">

                    Login To Book
                </a>
            }

        </div>

    </section>

</div>