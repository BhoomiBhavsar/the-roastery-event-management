<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Elite Events Restaurant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <style>
        :root {
            --espresso-brown: #2B1408;
            --coffee-roast: #452816;
            --caramel-brown: #734120;
            --golden-beige: #E0C49F;
            --light-beige: #F5EFE1;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--espresso-brown);
            background-color: var(--light-beige);
        }

        /* Navigation Bar */
        .navbar {
            background: linear-gradient(135deg, var(--espresso-brown) 0%, var(--coffee-roast) 100%);
            padding: 1rem 0;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-size: 1.8rem;
            font-weight: bold;
            color: var(--golden-beige) !important;
            letter-spacing: 1px;
        }

        .navbar-nav .nav-link {
            color: var(--light-beige) !important;
            margin-left: 1rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .navbar-nav .nav-link:hover {
            color: var(--golden-beige) !important;
            text-decoration: underline;
        }

        .navbar-nav .nav-link.active {
            color: var(--golden-beige) !important;
        }

        /* Main Content */
        main {
            min-height: calc(100vh - 200px);
            padding: 2rem 0;
        }

        /* Container */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 1rem;
        }

        /* Cards and Sections */
        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 12px rgba(43, 20, 8, 0.15);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            height: 100%;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(43, 20, 8, 0.25);
        }

        .card-img-top {
            height: 250px;
            object-fit: cover;
        }

        .card-body {
            padding: 1.5rem;
        }

        .card-title {
            color: var(--espresso-brown);
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .card-text {
            color: #666;
            font-size: 0.95rem;
            margin-bottom: 1rem;
        }

        .btn {
            border-radius: 5px;
            padding: 0.6rem 1.5rem;
            font-weight: 500;
            transition: all 0.3s ease;
            border: none;
        }

        .btn-primary {
            background-color: var(--caramel-brown);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--espresso-brown);
            color: var(--golden-beige);
            transform: scale(1.05);
        }

        .btn-outline-primary {
            border: 2px solid var(--caramel-brown);
            color: var(--caramel-brown);
        }

        .btn-outline-primary:hover {
            background-color: var(--caramel-brown);
            color: white;
        }

        /* Form Styling */
        .form-control, .form-select {
            border: 1px solid var(--golden-beige);
            border-radius: 5px;
            padding: 0.75rem;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--caramel-brown);
            box-shadow: 0 0 0 0.2rem rgba(115, 65, 32, 0.25);
        }

        .form-label {
            color: var(--espresso-brown);
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

        /* Section Titles */
        h1, h2, h3 {
            color: var(--espresso-brown);
            font-weight: bold;
            margin-bottom: 1rem;
        }

        /* Footer */
        footer {
            background: linear-gradient(135deg, var(--espresso-brown) 0%, var(--coffee-roast) 100%);
            color: var(--light-beige);
            padding: 2rem 0;
            margin-top: 2rem;
        }

        footer h5 {
            color: var(--golden-beige);
            font-weight: bold;
            margin-bottom: 1rem;
        }

        footer a {
            color: var(--light-beige);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        footer a:hover {
            color: var(--golden-beige);
        }

        footer .social-links a {
            margin-right: 1rem;
            font-size: 1.3rem;
        }

        .footer-bottom {
            border-top: 1px solid var(--caramel-brown);
            margin-top: 2rem;
            padding-top: 1rem;
            text-align: center;
        }

        /* Alert Messages */
        .alert {
            border-radius: 5px;
            border: none;
            padding: 1rem 1.5rem;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }

        .alert-info {
            background-color: #d1ecf1;
            color: #0c5460;
        }
    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index"> The Roastery</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-area="" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="EventTypes" asp-area="" asp-action="Index">Event Packages</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="EventBookings" asp-area="" asp-action="CustomEvent">Custom Event</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Pages" asp-area="" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Inquiries" asp-area="" asp-action="Index">Inquire</a>
                    </li>
                    @* @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="EventBookings" asp-action="MyBookings">My Bookings</a>
                        </li>
                        <li class="nav-item">
                            <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                                <button class="nav-link btn btn-link" type="submit">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login / Register</a>
                        </li>
                    } *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="EventBookings"
                               asp-action="MyBookings">
                                My Bookings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Inquiries"
                               asp-action="MyInquiries">
                                My Inquiries
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Profile"
                               asp-action="Index">
                                My Profile
                            </a>
                        </li>
                        <li class="nav-item">
                            <form class="d-inline"
                                  asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="/"
                                  method="post">

                                <button class="nav-link btn btn-link text-light border-0"
                                        type="submit">

                                    Logout

                                </button>

                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="Identity"
                               asp-page="/Account/Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area="Identity"
                               asp-page="/Account/Register">
                                Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5> The Roastery Restaurant</h5>
                    <p>Premium event management and catering services for your special occasions.</p>
                    <div class="social-links">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Quick Links</h5>
                    <ul style="list-style: none;">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="EventTypes" asp-action="Index">Event Packages</a></li>
                        <li><a asp-controller="Inquiries" asp-action="Index">Inquire</a></li>
                        <li><a asp-controller="Pages" asp-action="About">About Us</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5>Contact Information</h5>
                    <p>📍  The Roastery , vesu surat Gujarat</p>
                    <p>📞 9839847563</p>
                    <p>✉️ theroastery16@gmail.com</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026  The Roastery Restaurant. All rights reserved. | <a href="#">Privacy Policy</a> | <a href="#">Terms of Service</a></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
